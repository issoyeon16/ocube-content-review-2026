{
  "name": "ocube-corporate-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src *.ts *.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,mjs,css,html,json,md}\" \"*.{ts,js,mjs,json,md}\" \"docs/**/*.md\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,mjs,css,html,json,md}\" \"*.{ts,js,mjs,json,md}\" \"docs/**/*.md\""
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "swiper": "^12.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.9.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
